def get_my_tiles_properties(tmxdata, player_x, player_y): 
    tile_x = int(player_x //35)
    tile_y = int(player_y // 35)

    default_props = {"climbable": False, "ground": False, "health": 0, "point": 0, 
                     "provide": '', "require": '', "solid": False}

    for layer_idx in range(len(tmxdata.layers)): #alle map layer überprüfen an der koordinate
        try: 
            properties = tmxdata.get_tile_properties(tile_x, tile_y, layer_idx) 
            if properties is not None:  #wenn tile gefunden wurde zurück geben          
                return properties
        except (ValueError, KeyError):
            continue
                        
    return default_props

